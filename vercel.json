{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build -w apps/web",
  "outputDirectory": "apps/web/dist",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/uploads/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
